# ── Somafrik — production réelle ──
# Usage : npm run production:up  (charge .env.production après validation)
# Frontend web : Vercel (branche main → https://somafrik.app)
#
# Obligatoire :
#   NODE_ENV=production
#   SOMAFRIK_SKIP_DEMO_SEED=true
#   POSTGRES_PASSWORD et JWT_SECRET forts et uniques
#   APP_ENV=production  → CORS https://somafrik.app

NODE_ENV=production
APP_ENV=production
SOMAFRIK_API_DOMAIN=api.somafrik.app
BACKEND_PORT=5000
POSTGRES_HOST_PORT=5433
POSTGRES_DB=somafrik
POSTGRES_USER=somafrik
POSTGRES_PASSWORD=GENERER-MOT-DE-PASSE-FORT-ICI
JWT_SECRET=GENERER-SECRET-JWT-32-CARACTERES-MINIMUM-ICI
SOMAFRIK_DB_REQUIRED=true
SOMAFRIK_SKIP_DEMO_SEED=true
SOMAFRIK_DISABLE_LOGIN_LOCKOUT=false
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT=2mb

# Isolation push — frontière serveur = APP_ENV. Auto-test /push-devices/test toujours interdit en production.

# Pièces jointes Communications (Messages / Annonces / Notifications).
# OBLIGATOIRE en production. INTERDIT : /tmp.
# Render : Disk persistant, ex. /var/data/communication-storage
SOMAFRIK_COMMUNICATION_STORAGE=/var/lib/somafrik/communication-storage

EXPO_PUBLIC_API_URL=https://api.somafrik.app
EXPO_PORT=8083

# Build Vercel (branche main) — variables à définir dans le dashboard Vercel
# VITE_API_URL=https://api.somafrik.app
# VITE_SHOW_DEMO_ACCOUNTS=false
# VITE_ENABLE_MARKETPLACE=false
