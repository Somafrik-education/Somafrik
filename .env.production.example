# ── Somafrik — production réelle ──
# Copier vers .env avant déploiement (ne pas utiliser pour le dev local Docker).
#
# Obligatoire :
#   NODE_ENV=production
#   SOMAFRIK_SKIP_DEMO_SEED=true
#   POSTGRES_PASSWORD et JWT_SECRET forts et uniques
#   CORS_ORIGINS : uniquement vos domaines publics HTTPS (pas de localhost ni IP LAN)

NODE_ENV=production
BACKEND_PORT=5000
POSTGRES_HOST_PORT=5433
POSTGRES_DB=somafrik
POSTGRES_USER=somafrik
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-this-long-random-secret-before-use
CORS_ORIGINS=https://app.somafrik.com
WEB_DEV_PORT=5173
SOMAFRIK_DB_REQUIRED=true
SOMAFRIK_SKIP_DEMO_SEED=true
JSON_BODY_LIMIT=1mb
EXPO_PORT=8083
