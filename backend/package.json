{
  "name": "somafrik-backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "dev:memory": "node scripts/dev-memory.js",
    "dev:nodemon": "nodemon server.js",
    "verify:establishment": "node scripts/verify-establishment-e2e.js",
    "verify:planning-conflicts": "node scripts/verify-planning-conflicts.js",
    "test": "node --test tests/**/*.test.js",
    "test:auth": "node --test tests/auth.test.js",
    "test:roles": "node --test tests/roles-permissions.test.js",
    "test:integrity": "node --test tests/data-integrity.test.js",
    "test:unit": "node --test tests/unit-priority.test.js",
    "test:all": "node --test tests/**/*.test.js",
    "postinstall": "node ./node_modules/puppeteer/install.mjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "mongoose": "^8.24.0",
    "pg": "^8.21.0",
    "puppeteer": "^25.3.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
