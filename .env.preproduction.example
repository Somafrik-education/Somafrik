# ── Somafrik — préproduction MVP ──
# Copier vers .env puis : npm run preprod:up
#
# 1. Renseigner les secrets (openssl rand -hex 32 pour JWT_SECRET)
# 2. SOMAFRIK_DOMAIN = domaine officiel somafrik.app
# 3. CORS_ORIGINS = origines HTTPS autorisées (web + mobile web si applicable)
# 4. npm run preprod:bootstrap  (superadmin initial)
#
# URLs attendues :
#   Application : https://<SOMAFRIK_DOMAIN>/web/
#   API         : https://<SOMAFRIK_DOMAIN>/api/health

NODE_ENV=production
SOMAFRIK_ENV=preproduction

# Domaine public (Caddy + certificat TLS automatique)
SOMAFRIK_DOMAIN=somafrik.app
CORS_ORIGINS=https://somafrik.app

# Secrets — OBLIGATOIRE : remplacer avant déploiement
POSTGRES_DB=somafrik
POSTGRES_USER=somafrik
POSTGRES_PASSWORD=GENERER-MOT-DE-PASSE-FORT-ICI
JWT_SECRET=GENERER-SECRET-JWT-32-CARACTERES-MINIMUM-ICI

# Base de données (interne Docker, non exposée)
SOMAFRIK_DB_REQUIRED=true
SOMAFRIK_SKIP_DEMO_SEED=true
SOMAFRIK_DISABLE_LOGIN_LOCKOUT=false
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT=2mb

# Superadmin initial (npm run preprod:bootstrap)
BOOTSTRAP_SUPERADMIN_ID=superadmin
BOOTSTRAP_SUPERADMIN_PASSWORD=GENERER-MOT-DE-PASSE-FORT-ICI
BOOTSTRAP_SUPERADMIN_EMAIL=superadmin@somafrik.app

# Mobile — URL injectée au build EAS (profil production)
EXPO_PUBLIC_API_URL=https://somafrik.app

# Build web : masquer les comptes démo sur la page de connexion
VITE_SHOW_DEMO_ACCOUNTS=false
