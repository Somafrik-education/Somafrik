# ── Somafrik — préproduction MVP ──
# API hébergée sur Render : https://somafrik-api-preprod.onrender.com
# Frontend web : Vercel (branche develop → https://preprod.somafrik.app)
#            ou Render → https://somafrik-web-preprod.onrender.com
#
# 1. Renseigner les secrets (openssl rand -hex 32 pour JWT_SECRET)
# 2. Render : variables d'environnement du service web (DATABASE_URL, JWT_SECRET, CORS_ORIGINS…)
# 3. Render web : VITE_API_URL=https://somafrik-api-preprod.onrender.com
#    Vercel (develop) : idem
# 4. npm run preprod:bootstrap  (superadmin initial, base Render ou Docker local)
#
# URLs attendues :
#   Web préprod  : https://somafrik-web-preprod.onrender.com/  (ou https://preprod.somafrik.app/)
#   API préprod  : https://somafrik-api-preprod.onrender.com/api/health

NODE_ENV=production
SOMAFRIK_ENV=preproduction

# Domaine public de l'API (Render)
SOMAFRIK_API_DOMAIN=somafrik-api-preprod.onrender.com

# Frontend web préprod : Render (ou Vercel preprod.somafrik.app)
# CORS : origine exacte du frontend (sans slash final)
CORS_ORIGINS=https://somafrik-web-preprod.onrender.com

# Secrets — OBLIGATOIRE : remplacer avant déploiement
POSTGRES_DB=somafrik
POSTGRES_USER=somafrik
POSTGRES_PASSWORD=GENERER-MOT-DE-PASSE-FORT-ICI
POSTGRES_HOST_PORT=5434
JWT_SECRET=GENERER-SECRET-JWT-32-CARACTERES-MINIMUM-ICI

# Base de données (Render : utiliser DATABASE_URL fournie par Postgres Render)
SOMAFRIK_DB_REQUIRED=true
SOMAFRIK_SKIP_DEMO_SEED=true
SOMAFRIK_DISABLE_LOGIN_LOCKOUT=false
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT=2mb

# Superadmin initial (npm run preprod:bootstrap)
BOOTSTRAP_SUPERADMIN_ID=superadmin
BOOTSTRAP_SUPERADMIN_PASSWORD=GENERER-MOT-DE-PASSE-FORT-ICI
BOOTSTRAP_SUPERADMIN_EMAIL=superadmin@somafrik.app

# Mobile — URL injectée au build EAS (profil preview / préprod)
EXPO_PUBLIC_API_URL=https://somafrik-api-preprod.onrender.com

# Build Vercel (branche develop) — variables à définir dans le dashboard Vercel
# VITE_API_URL=https://somafrik-api-preprod.onrender.com
# VITE_SHOW_DEMO_ACCOUNTS=false
# VITE_ENABLE_MARKETPLACE=false
