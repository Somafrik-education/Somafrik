# Reverse proxy HTTPS pour l'API Somafrik (sous-domaines api.*).
# Caddy obtient automatiquement un certificat Let's Encrypt lorsque SOMAFRIK_API_DOMAIN
# pointe vers ce serveur (enregistrement DNS A/AAAA).
{$SOMAFRIK_API_DOMAIN:localhost} {
	encode gzip zstd

	reverse_proxy backend:5000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	log {
		output stdout
		format console
	}
}
