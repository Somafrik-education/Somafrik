# ── Somafrik — environnement Démo public ──
# IMPORTANT : cet exemple ne contient aucun secret réel.
# Environnement totalement séparé de production et préproduction.
# Web attendu : https://demo.somafrik.app
# API publique attendue : https://api-demo.somafrik.app
# PostgreSQL : datastore dédié dont le nom/URL contient le marqueur `somafrik_demo`.

NODE_ENV=production
APP_ENV=demo
SOMAFRIK_ENV=demo

# Frontière publique
SOMAFRIK_API_DOMAIN=api-demo.somafrik.app
DEMO_FRONTEND_ORIGIN=https://demo.somafrik.app

# PostgreSQL DÉMO UNIQUEMENT
# Injectée par Render. Ne jamais copier une URL PROD/PREPROD ici.
DATABASE_URL=
SOMAFRIK_DB_REQUIRED=true
SOMAFRIK_SKIP_DEMO_SEED=true
SOMAFRIK_DISABLE_LOGIN_LOCKOUT=false

# Garde destructive du reset Démo (#665)
# Le marqueur DOIT apparaître dans DATABASE_URL et contenir >= 8 caractères.
SOMAFRIK_DEMO_DATABASE_URL_MARKER=somafrik_demo
# À fournir uniquement pendant une opération de reset contrôlée ; ne pas laisser activé en permanence.
# SOMAFRIK_DEMO_RESET_CONFIRM=RESET_DEMO_DATA

# Passerelle Démo
# PORT est fourni par Render au process public : ne pas le figer dans Git.
DEMO_INNER_PORT=5001
DEMO_ENTRY_CODE_TTL_SECONDS=120
DEMO_SESSION_TTL_SECONDS=900
DEMO_ENTRY_RATE_LIMIT_WINDOW_MS=60000
DEMO_ENTRY_RATE_LIMIT_MAX=10
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT=2mb

# Compte établissement fictif utilisé uniquement par l'auth interne de la passerelle.
DEMO_DEFAULT_ROLE=school_admin
DEMO_SCHOOL_CODE=CD-IN-26-001
DEMO_IDENTIFIER=admin
DEMO_INTERNAL_SEED_PIN=GENERER-SECRET-DEMO-ICI

# Secret JWT propre à la Démo. Ne jamais réutiliser PROD/PREPROD.
JWT_SECRET=GENERER-SECRET-JWT-DEMO-32-CARACTERES-MINIMUM

# Stockage communications : sandbox Démo uniquement.
SOMAFRIK_COMMUNICATION_STORAGE=/var/lib/somafrik-demo/communication-storage

# Web Démo — variables de build du Static Site, pas du backend.
# VITE_API_URL=https://api-demo.somafrik.app
# VITE_DEMO_ENTRY_API_URL=https://api-demo.somafrik.app
# VITE_DEMO_WEB_ORIGIN=https://demo.somafrik.app
# VITE_ENABLE_PUBLIC_DEMO=false
# VITE_SHOW_DEMO_ACCOUNTS=false
# VITE_ENABLE_MARKETPLACE=false

# Externalités : laisser désactivées/sandboxées tant que DEMO-4 n'est pas validé.
SOMAFRIK_PUSH_SELFTEST_ENABLED=false
