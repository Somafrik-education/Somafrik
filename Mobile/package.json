    "e2e:fault-proxy": "node scripts/mobile-e2e-fault-proxy.js",
    "verify:mobile-release-readiness": "node scripts/verify-mobile-release-readiness.js",
    "verify:mobile-preview-apk": "node scripts/verify-mobile-preview-apk.js",
    "test:preview-apk-eas-auth": "node scripts/verify-mobile-preview-apk.test.js",
    "verify:mobile-native-aab": "node scripts/verify-native-prebuild.js",
    "test:release-environments": "node config/releaseEnvironments.test.js",
    "test:network-resilience": "npx --yes tsx src/lib/networkResilience.test.ts && npx --yes tsx src/lib/mutationGuard.test.ts && npx --yes tsx src/lib/outbox.test.ts"
