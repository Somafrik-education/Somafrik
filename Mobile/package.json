    "verify:mobile-domain-hydration": "node scripts/verify-mobile-domain-hydration.js",
    "verify:mobile-network-resilience": "node scripts/verify-mobile-network-resilience.js",
    "verify:mobile-usability": "node scripts/verify-mobile-usability.js",
    "verify:mobile-home-data-truth": "node scripts/verify-mobile-home-data-truth.js",
