    "test:platform-notification-sync": "npx --yes tsx src/lib/platformNotificationSync.test.ts",
    "test:data-truth": "npx --yes tsx src/lib/dataTruth.test.ts",
    "test:scope": "npx --yes tsx src/lib/scope.test.ts",
