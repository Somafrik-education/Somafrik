    "verify:mobile-no-catalog-runtime-data": "node scripts/verify-mobile-no-catalog-runtime-data.js",
    "verify:mobile-canonical-route-map": "node scripts/verify-mobile-canonical-route-map.js",
    "verify:mobile-attendance-hydration": "node scripts/verify-mobile-attendance-hydration.js",
    "verify:mobile-ui-e2e-scaffold": "node scripts/verify-mobile-ui-e2e-scaffold.js",
