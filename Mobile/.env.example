# Variables Expo locales (machine / telephone). Ne pas mettre dans .env racine (Expo 57+).
# Genere automatiquement par : npm run sync:env
LAN_IP=ADRESSE_IP_DU_PC
EXPO_PORT=8083
REACT_NATIVE_PACKAGER_HOSTNAME=ADRESSE_IP_DU_PC
EXPO_PUBLIC_RELEASE_PROFILE=development
EXPO_PUBLIC_API_URL=http://ADRESSE_IP_DU_PC:5000
EXPO_PUBLIC_API_URL_DEV=http://ADRESSE_IP_DU_PC:5000
# URLs store (déjà utilisées par Somafrik — ne pas inventer) :
# EXPO_PUBLIC_API_URL_PREVIEW=https://somafrik-api-preprod.onrender.com
# EXPO_PUBLIC_API_URL_PREPRODUCTION=https://somafrik-api-preprod.onrender.com
# EXPO_PUBLIC_API_URL_PRODUCTION=https://api.somafrik.app
EXPO_PUBLIC_DEMO_MODE=false
# PIN démo local uniquement (Expo Go / __DEV__). Jamais en preview/preproduction/production. Aucun fallback.
# EXPO_PUBLIC_DEMO_PIN=

# LOT 8 E2E runtime — noms seulement, aucune valeur secrète.
# SOMAFRIK_E2E_SCHOOL_CODE=
# SOMAFRIK_E2E_IDENTIFIER=
# SOMAFRIK_E2E_PASSWORD=
# SOMAFRIK_E2E_APK_PATH=
