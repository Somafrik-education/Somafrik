# ── Somafrik — tout sur Docker (recommandé) ──
# Copier vers .env puis : npm run docker:up
# Script avec détection IP : powershell -ExecutionPolicy Bypass -File scripts\docker-up.ps1
#
# URLs :
#   API        http://localhost:5000/api/health
#   BackOffice http://localhost:5000/backoffice/
#   Web build  http://localhost:5000/web/
#   Web dev    http://localhost:5173/web/
#   Expo       port EXPO_PORT (défaut 8083) — npm run docker:logs:mobile
#
# Ne pas lancer npm run backend en parallèle (conflit port 5000).

# Développement local / démo Docker (voir .env.production.example pour la prod réelle) :
#   NODE_ENV=development
#   SOMAFRIK_SKIP_DEMO_SEED=false
#   CORS_ORIGINS : localhost + IP LAN (voir npm run sync:env)
# Production réelle :
#   NODE_ENV=production
#   SOMAFRIK_SKIP_DEMO_SEED=true
#   CORS_ORIGINS=https://somafrik.app
NODE_ENV=development
BACKEND_PORT=5000
POSTGRES_HOST_PORT=5433
POSTGRES_DB=somafrik
POSTGRES_USER=somafrik
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-this-long-random-secret-before-use
# IP LAN du PC (Wi-Fi) — detectee par npm run sync:env ; remplace ADRESSE_IP_DU_PC dans CORS et Mobile/.env.local
LAN_IP=ADRESSE_IP_DU_PC
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8083,http://127.0.0.1:8083
WEB_DEV_PORT=5173
SOMAFRIK_DB_REQUIRED=true
SOMAFRIK_SKIP_DEMO_SEED=false
JSON_BODY_LIMIT=1mb

# Port Metro pour Docker Compose (service mobile).
# IP LAN + variables Expo : npm run sync:env (genere Mobile/.env.local depuis LAN_IP)
EXPO_PORT=8083
