# Origine API — OBLIGATOIRE (sans slash final /api ; ajouté automatiquement par le client).
# Local : http://localhost:5000
# Production Render (main) : https://api.somafrik.app
# Préproduction (develop) : https://somafrik-api-preprod.onrender.com
VITE_API_URL=http://localhost:5000

# Cible du proxy Vite en dev (optionnel, aligné sur VITE_API_URL).
VITE_API_TARGET=http://localhost:5000

# Chemin de base de l'application.
# somafrik.app / preprod.somafrik.app : / (défaut, ne pas définir)
# Docker backend intégré (localhost:5000/web/) : /web/
# VITE_BASE_PATH=/web/

# Marketplace — route /marketplace, placeholder sans API.
VITE_ENABLE_MARKETPLACE=false

# Comptes démo sur la page de connexion (true en dev local, false en prod / préprod).
VITE_SHOW_DEMO_ACCOUNTS=true

# Démo publique — deux interrupteurs séparés pour permettre la recette avant publication du CTA.
# VITE_ENABLE_DEMO_ENTRY=true rend /demo interactif sans modifier la vitrine.
# VITE_ENABLE_PUBLIC_DEMO=true est réservé à la publication future des CTA Démo.
VITE_ENABLE_DEMO_ENTRY=false
VITE_ENABLE_PUBLIC_DEMO=false
VITE_DEMO_ENTRY_API_URL=https://api-demo.somafrik.app
VITE_DEMO_WEB_ORIGIN=https://demo.somafrik.app
