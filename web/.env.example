# Origine API — OBLIGATOIRE (sans slash final /api ; ajouté automatiquement par le client).
# Local : http://localhost:5000
# Production Vercel (main) : https://api.somafrik.app
# Préproduction Vercel (develop) : https://api-preprod.somafrik.app
VITE_API_URL=http://localhost:5000

# Cible du proxy Vite en dev (optionnel, aligné sur VITE_API_URL).
VITE_API_TARGET=http://localhost:5000

# Chemin de base de l'application.
# Vercel (somafrik.app, preprod.somafrik.app) : / (défaut, ne pas définir)
# Docker backend intégré (localhost:5000/web/) : /web/
# VITE_BASE_PATH=/web/

# Marketplace — route /marketplace, placeholder sans API.
VITE_ENABLE_MARKETPLACE=false

# Comptes démo techniques sur la page de connexion (true en dev local, false en prod / préprod).
# Ne pas confondre avec l'environnement public Démo Somafrik.
VITE_SHOW_DEMO_ACCOUNTS=true

# Parcours public vitrine → environnement Démo. Désactivé par défaut tant que l'API Démo
# et les domaines dédiés ne sont pas opérationnels. L'URL d'entrée est volontairement
# distincte de VITE_API_URL : aucune retombée vers PROD/PREPROD n'est autorisée.
VITE_ENABLE_PUBLIC_DEMO=false
VITE_DEMO_WEB_ORIGIN=https://demo.somafrik.app
VITE_DEMO_ENTRY_API_URL=https://api-demo.somafrik.app
