    "serverForcesFullReconciliation": true,
    "cursorStatus": ["ok", "scope_changed", "expired"],
    "ignoreExpiredWarmDelta": "P0 bug (local zombies)"
  },
  "tenantPolicy": "partition userId+schoolId AND purge on logout",
  "syncOrder": "auth/RBAC → blocked_authorization (no silent drop) → pull delta or mini-cold or full resync → replay pending outbox → pull delta final",
